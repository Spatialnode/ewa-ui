{
  "name": "@spatialnode/ewa-ui",
  "version": "0.2.5",
  "description": "Spatialnode React component library",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spatialnode/ewa-ui"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./recharts": {
      "import": {
        "types": "./dist/recharts.d.mts",
        "default": "./dist/recharts.mjs"
      },
      "require": {
        "types": "./dist/recharts.d.cts",
        "default": "./dist/recharts.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "rm -rf dist && node scripts/build-css.mjs",
    "build": "tsdown",
    "postbuild": "node scripts/copy-maplibre-worker.mjs dist && node scripts/inject-css-import.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "component-library",
    "ewa-ui",
    "Spatialnode-ui",
    "design-system"
  ],
  "author": "Spatialnode",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "playwright": "latest",
    "postcss": "^8.5.29",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@geomatico/maplibre-cog-protocol": "^0.9.3",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-table": "^9.2.6",
    "@vis.gl/react-maplibre": "^8.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "6.3.0",
    "radix-ui": "^1.7.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  }
}